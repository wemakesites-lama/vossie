# The address the live site is served from, with no path. It becomes the base of share-card, robots.txt and sitemap
# addresses (lib/site-url.ts). Next reads it when it builds, so set it in the host's build environment too, not only at
# run time. Leave it unset while developing: it falls back to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://vossie.example

# Sample mode (accounts spec 2.1): accounts live in the server's memory and are wiped when it restarts, sign-in codes
# show on the screen, and five sample accounts sign in with one tap. On unless set to 0; with it off and no backend,
# sign-in says it isn't available yet.
# VOSSIE_SAMPLE_MODE=0

# The email domains that can sign in, comma-separated: an address at exactly one of them, never a subdomain. Defaults
# to eduvos.com and vossie.net (students sign in as eduv and 7 digits at vossie.net, staff at eduvos.com), so
# production needn't set it. The live site sets the same value anyway (Lama's decision 2, 2026-10-21), so the app and
# Supabase's allowed_email_domains agree whatever the default becomes. Local end-to-end runs add vossie.test.
# VOSSIE_EMAIL_DOMAINS=vossie.net,eduvos.com

# Hide the whole site from search engines (decision 68): every response says X-Robots-Tag: noindex, nofollow, and
# robots.txt disallows everything, with no sitemap. For a deployment that is public but not for search, such as the
# preview before launch. Read when Next builds, so set it in the host's build environment. Off unless set to 1.
# VOSSIE_NOINDEX=1

# The Supabase backend (backend spec section 8). Server only: none is NEXT_PUBLIC_, and the browser never talks to
# Supabase. Real values go in .env.local and the host's settings, never here. VOSSIE_BACKEND is "sample" (the default)
# or "supabase". "supabase" turns sample mode off, whatever VOSSIE_SAMPLE_MODE says (Supabase phase B decision 1): no
# sample accounts, no code on screen, and the development key refused. Set the Supabase values for Vercel's Production
# environment only, so a branch preview stays on sample mode (decision 13). The secret key bypasses every access rule;
# locally, `supabase status -o env` prints the keys.
# VOSSIE_BACKEND=
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# CRON_SECRET: Vercel Cron's bearer for /api/cron/photos, the daily photo sweep (Supabase only; C2/C3 plan decision 15).
# At least 32 random characters, or the route refuses every call; Production only. Lama sets it in Vercel; never in
# the repo.
# CRON_SECRET=

# The secret that keys the hashes of sign-in codes, session tokens and sign-in attempt tokens (stage K). At least 32
# characters: make one with `openssl rand -base64 32`. Unset in sample mode, a fixed development key is used and the
# server logs a warning; unset with sample mode off, signing in refuses to run. Changing it signs everyone out.
# On Supabase it keys only the sign-in attempt cookie: changing it ends sign-ins in progress, not sessions.
# VOSSIE_AUTH_HMAC_KEY=
